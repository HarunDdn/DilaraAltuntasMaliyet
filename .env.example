# DEBAK Maliyet Hesaplama — ortam degiskenleri
#
# Bu dosyayi ".env" olarak kopyalayin ve degerleri doldurun.
# .env dosyasi .gitignore icindedir; ASLA commit edilmez.
# Iki deger de tanimli olmadan sunucu baslamaz.

# Ekip giris sifresi (arayuzdeki "Ekip sifresi" alani)
APP_PASSWORD=buraya-ekip-sifresini-yaz

# Cookie imzalama sirri. Rastgele ve en az 32 karakter olmali.
# Uretmek icin:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Bu deger degisirse tum acik oturumlar gecersiz olur (herkes bir kez yeniden giris yapar).
COOKIE_SECRET=buraya-rastgele-uzun-bir-deger-yaz

# HTTPS uzerinden yayin yapiliyorsa true yapin (cookie yalnizca sifreli baglantida gonderilir).
# Duz HTTP ic agda false kalmali, aksi halde giris calismaz.
COOKIE_SECURE=false

# IIS/iisnode portu kendisi verir. Yerel calistirmada bos birakabilirsiniz.
# PORT=3000
