<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- iisnode handler: Node.js uygulamasını IIS üzerinden çalıştırır -->
    <handlers>
      <!-- WebDAV, DELETE/PUT isteklerini iisnode'a ulaşmadan 405 ile keser -->
      <remove name="WebDAV" />
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- Kayıt silme (DELETE /api/calculations/:id) için WebDAV modülü devre dışı -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>

    <!-- URL Rewrite: Tüm istekleri server.js'e yönlendirir -->
    <rewrite>
      <rules>
        <!-- GÜVENLİK: sır ve kaynak dosyaları hiçbir koşulda servis edilmesin.
             Bu kural en başta durmalı: aşağıdaki DynamicContent kuralı
             "dosya YOKSA" eşleştiği için, .env gibi kökte gerçekten var olan
             dosyalar Node'a gitmez ve IIS'in statik işleyicisine düşebilir. -->
        <rule name="BlockSensitiveFiles" stopProcessing="true">
          <match url="(^|/)(\.env.*|web\.config|package(-lock)?\.json|server\.js|[^/]*\.md)$" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <!-- Statik dosyalar (public klasörü) doğrudan servis edilsin -->
        <rule name="StaticContent" stopProcessing="true">
          <match url="^public/(.*)" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="public/{R:1}" />
        </rule>

        <!-- Diğer tüm istekler Node.js'e yönlendirilsin -->
        <rule name="DynamicContent" stopProcessing="true">
          <match url="/*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- iisnode yapılandırması -->
    <iisnode
      nodeProcessCommandLine="&quot;%programfiles%\nodejs\node.exe&quot;"
      watchedFiles="web.config;*.js"
      loggingEnabled="true"
      logDirectory="iisnode"
      devErrorsEnabled="false"
      node_env="production"
    />

    <!-- Güvenlik: veri, log ve sır dosyalarını tarayıcıdan erişime kapat -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="iisnode" />
          <add segment="data" />
          <add segment=".env" />
          <add segment=".env.example" />
          <add segment=".git" />
          <add segment=".cursor" />
          <add segment="docs" />
          <add segment="skills" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <!-- Sunucu parmak izini azalt -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>

    <!-- Statik dosya MIME türleri -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
  </system.webServer>
</configuration>
